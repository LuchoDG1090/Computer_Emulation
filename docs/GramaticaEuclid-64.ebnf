/*
 * GRAMÁTICA EBNF EUCLID-64
 */

/* 1. ESTRUCTURA DEL PROGRAMA */
program ::= ( declaration | func_decl | adt_decl )*

/* 2. TIPOS DE DATOS */
type ::= 'int' | 'float' | 'string' | 'bool' | 'char' | 'void'

/* 3. DECLARACIONES */
declaration ::= type ID ( array_suffix )? ( '=' exp )?
array_suffix ::= '[' exp ']' ( '[' exp ']' )*

/* 4. FUNCIONES */
func_decl ::= 'func' ID '(' ( param_list )? ')' ':' block 'endfunc'
param_list ::= param ( ',' param )*
param ::= type ID ( array_suffix )?

/* 5. ADTs (TIPOS ABSTRACTOS DE DATOS) */
adt_decl ::= 'adt' ID '(' ( param_list )? ')' ':' adt_body 'endadt'
adt_body ::= ( visibility_block | attribute_decl | func_decl )*
visibility_block ::= ( 'private' | 'public' ) ':' ( attribute_decl | func_decl )*
attribute_decl ::= type ID ( array_suffix )?

/* 6. BLOQUES Y SENTENCIAS */
block ::= statement*
statement ::= declaration
    | assign_stmt
    | if_stmt
    | while_stmt
    | for_stmt
    | func_call
    | return_stmt
    | 'break'
    | 'continue'
    | output_stmt
    | input_stmt

/* 7. ASIGNACIÓN */
assign_stmt ::= lvalue '=' exp
lvalue ::= ID ( ( '[' exp ']' ) | ( '.' ID ) )*

/* 8. ENTRADA / SALIDA */
output_stmt ::= 'output' exp
input_stmt ::= 'input' lvalue

/* 9. ESTRUCTURAS DE CONTROL */
if_stmt ::= 'if' '(' exp ')' ':' block ( 'else' ':' block )? 'endif'
while_stmt ::= 'while' '(' exp ')' ':' block 'endwhile'
for_stmt ::= 'for' '(' ID 'in' range ')' ':' block 'endfor'
range ::= exp '..' exp
return_stmt ::= 'return' ( exp )?

/* 10. LLAMADAS A FUNCIONES */
func_call ::= ID '(' ( arg_list )? ')'
arg_list ::= exp ( ',' exp )*

/* 11. EXPRESIONES - Jerarquía de operadores */
exp ::= logical_or_exp
logical_or_exp ::= logical_and_exp ( '||' logical_and_exp )*
logical_and_exp ::= bitwise_or_exp ( '&&' bitwise_or_exp )*
bitwise_or_exp ::= bitwise_xor_exp ( '|' bitwise_xor_exp )*
bitwise_xor_exp ::= bitwise_and_exp ( '^' bitwise_and_exp )*
bitwise_and_exp ::= equality_exp ( '&' equality_exp )*
equality_exp ::= relational_exp ( ( '==' | '!=' ) relational_exp )*
relational_exp ::= shift_exp ( ( '<' | '<=' | '>' | '>=' ) shift_exp )*
shift_exp ::= additive_exp ( ( '<<' | '>>' ) additive_exp )*
additive_exp ::= multiplicative_exp ( ( '+' | '-' ) multiplicative_exp )*
multiplicative_exp ::= power_exp ( ( '*' | '/' | '%' ) power_exp )*
power_exp ::= unary_exp ( '**' unary_exp )*
unary_exp ::= ( '!' | '-' | '+' | '~' | '++' | '--' )? primary_exp
primary_exp ::= INTEGER
    | FLOAT
    | STRING
    | TRUE
    | FALSE
    | lvalue
    | func_call
    | adt_constructor
    | '(' exp ')'

/* 12. CONSTRUCTORES DE ADT */
adt_constructor ::= ID '(' ( arg_list )? ')'

/* 13. TOKENS LÉXICOS */
INTEGER ::= [0-9]+
FLOAT ::= [0-9]+ '.' [0-9]+ ( [eE] [+-]? [0-9]+ )?
STRING ::= '"' [^"]* '"' | "'" [^']* "'"
TRUE ::= 'true'
FALSE ::= 'false'
ID ::= [a-zA-Z_] [a-zA-Z0-9_]*